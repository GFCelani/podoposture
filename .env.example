# Variaveis do painel de publicacao (/publicar).
#
# NENHUMA e obrigatoria para o site funcionar. Sem elas, o site constroi, serve
# as 88 URLs e mostra os 68 posts normalmente — so o painel fica indisponivel,
# respondendo 503. Isso e de proposito: uma funcionalidade nova nao pode ser
# capaz de derrubar o site da clinica por falta de configuracao.

# Resumo da senha e segredo de assinatura da sessao.
# Gere os dois de uma vez com:   npm run senha -- "a senha escolhida"
# A senha em texto nunca e guardada; o que vai aqui e o scrypt dela.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Postgres onde moram os posts novos e as imagens enviadas pelo painel.
# Os 68 posts migrados NAO vivem aqui — eles continuam no JSON do repositorio.
# Qualquer Postgres serve (Neon, Supabase, local). As tabelas se criam sozinhas
# no primeiro acesso.
DATABASE_URL=

# Quantos proxies confiaveis existem na frente da aplicacao, se ela NAO estiver
# na Vercel. Serve para saber qual pedaco de `x-forwarded-for` foi escrito por
# alguem em quem se pode confiar. Na Vercel, deixe vazio: a plataforma manda
# `x-vercel-forwarded-for`, que o cliente nao consegue forjar.
PROXY_HOPS=

# Endereco canonico. So precisa mudar se o dominio mudar.
NEXT_PUBLIC_SITE_URL=

# Libera o rastreamento pelos buscadores. Ligue (=1) SO no dia em que
# podoposture.com.br apontar para este servidor — antes disso, o site novo e uma
# copia do que ja esta no ar e as duas brigariam pelas mesmas buscas.
DOMINIO_NO_AR=
